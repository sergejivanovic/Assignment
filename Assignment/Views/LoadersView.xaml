<UserControl x:Class="Assignment.Views.LoadersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Assignment.Views" xmlns:local1="clr-namespace:Assignment.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Thread 1 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
            <Label Content="Thread progress" Width="120" VerticalAlignment="Center"/>
            <ProgressBar Value="{Binding Threads[0].Progress, Mode=OneWay}" Minimum="0" Maximum="100"
                         Width="250" Height="20" VerticalAlignment="Center"/>
            <Label Content="{Binding Threads[0].Progress, StringFormat={}{0:F0}%}" Width="45" VerticalAlignment="Center"/>
            <Button Content="Cancel" Width="60" Margin="5,0"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding Threads[0]}"
                    IsEnabled="{Binding Threads[0].IsActive}"/>
        </StackPanel>

        <!-- Thread 2 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <Label Content="Thread progress" Width="120" VerticalAlignment="Center"/>
            <ProgressBar Value="{Binding Threads[1].Progress, Mode=OneWay}" Minimum="0" Maximum="100"
                         Width="250" Height="20" VerticalAlignment="Center"/>
            <Label Content="{Binding Threads[1].Progress, StringFormat={}{0:F0}%}" Width="45" VerticalAlignment="Center"/>
            <Button Content="Cancel" Width="60" Margin="5,0"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding Threads[1]}"
                    IsEnabled="{Binding Threads[1].IsActive}"/>
        </StackPanel>

        <!-- Thread 3 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <Label Content="Thread progress" Width="120" VerticalAlignment="Center"/>
            <ProgressBar Value="{Binding Threads[2].Progress, Mode=OneWay}" Minimum="0" Maximum="100"
                         Width="250" Height="20" VerticalAlignment="Center"/>
            <Label Content="{Binding Threads[2].Progress, StringFormat={}{0:F0}%}" Width="45" VerticalAlignment="Center"/>
            <Button Content="Cancel" Width="60" Margin="5,0"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding Threads[2]}"
                    IsEnabled="{Binding Threads[2].IsActive}"/>
        </StackPanel>

        <!-- Total progress -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Label Content="Total progress" Width="120" VerticalAlignment="Center"/>
            <ProgressBar Value="{Binding TotalProgress, Mode=OneWay}" Minimum="0" Maximum="100"
                         Width="250" Height="20" VerticalAlignment="Center"/>
            <Label Content="{Binding TotalProgress, StringFormat={}{0:F0}%}" Width="45" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
